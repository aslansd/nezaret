{
  "imports": [
    "$import glob",
    "$import os"
  ],
  "image_key": "image",
  "label_key": "label",
  "dataset_dir": "/workspace/data/Task09_Spleen",
  "train": {
    "deterministic_transforms": [
      {
        "_target_": "LoadImaged",
        "keys": [
          "@image_key",
          "@label_key"
        ]
      },
      {
        "_target_": "EnsureChannelFirstd",
        "keys": [
          "@image_key",
          "@label_key"
        ]
      },
      {
        "_target_": "Orientationd",
        "keys": [
          "@image_key",
          "@label_key"
        ],
        "axcodes": "RAS"
      },
      {
        "_target_": "Spacingd",
        "keys": [
          "@image_key",
          "@label_key"
        ],
        "pixdim": [
          1.5,
          1.5,
          2.0
        ]
      },
      {
        "_target_": "ScaleIntensityRanged",
        "keys": "@image_key",
        "a_min": -57,
        "a_max": 164,
        "b_min": 0,
        "b_max": 1,
        "clip": true
      }
    ],
    "random_transforms": [
      {
        "_target_": "RandCropByPosNegLabeld",
        "keys": [
          "@image_key",
          "@label_key"
        ],
        "label_key": "@label_key",
        "spatial_size": [
          96,
          96,
          96
        ],
        "pos": 1,
        "neg": 1,
        "num_samples": 4
      },
      {
        "_target_": "RandRotated",
        "keys": "@image_key",
        "range_x": 0.3,
        "prob": 0.2
      },
      {
        "_target_": "RandGaussianNoised",
        "keys": [
          "@image_key",
          "@label_key"
        ],
        "prob": 0.1
      },
      {
        "_target_": "NormalizeIntensityd",
        "keys": "@image_key",
        "nonzero": true
      }
    ],
    "preprocessing": {
      "_target_": "Compose",
      "transforms": "$@train#deterministic_transforms + @train#random_transforms"
    }
  },
  "validate": {
    "preprocessing": {
      "_target_": "Compose",
      "transforms": [
        {
          "_target_": "LoadImaged",
          "keys": [
            "@image_key",
            "@label_key"
          ],
          "ensure_channel_first": true
        },
        {
          "_target_": "Orientationd",
          "keys": [
            "@image_key",
            "@label_key"
          ],
          "axcodes": "RAS"
        },
        {
          "_target_": "Spacingd",
          "keys": [
            "@image_key",
            "@label_key"
          ],
          "pixdim": [
            1.5,
            1.5,
            2.0
          ],
          "mode": [
            "bilinear",
            "nearest"
          ]
        },
        {
          "_target_": "ScaleIntensityRanged",
          "keys": "@image_key",
          "a_min": -57,
          "a_max": 164,
          "b_min": 0,
          "b_max": 1,
          "clip": true
        },
        {
          "_target_": "CropForegroundd",
          "keys": [
            "@image_key",
            "@label_key"
          ],
          "source_key": "@label_key",
          "margin": 10
        }
      ]
    }
  }
}